{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "import"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "curly": "error",
        "typescript/no-floating-promises": ["error", { "ignoreIIFE": true }],
        "typescript/no-base-to-string": ["error", { "ignoredTypeNames": ["Token"] }],
        "import/no-duplicates": ["error", { "preferInline": true }]
    },
    "overrides": [
        {
            "files": [
                "src/lib/**/*.ts",
                "src/infra/**/*.ts",
                "src/wikitext/**/*.ts",
                "src/notify/**/*.ts",
                "src/tasks/**/*.ts",
                "src/runner.ts"
            ],
            "rules": {
                "typescript/explicit-module-boundary-types": "error"
            }
        },
        {
            "files": ["src/api/**/*.ts", "src/wikitext/**/*.ts", "src/infra/**/*.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            { "group": ["@/lib", "@/lib/*"] },
                            { "group": ["@/tasks", "@/tasks/*"] },
                            { "group": ["@/notify", "@/notify/*"] },
                            { "group": ["@/runner"] }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["src/lib/**/*.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            { "group": ["@/tasks", "@/tasks/*"] },
                            { "group": ["@/notify", "@/notify/*"] },
                            { "group": ["@/runner"] }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["src/notify/**/*.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            { "group": ["@/lib", "@/lib/*"] },
                            { "group": ["@/tasks", "@/tasks/*"] },
                            { "group": ["@/runner"] }
                        ]
                    }
                ]
            }
        }
    ],
    "env": {
        "builtin": true
    },
    "options": {
        "typeAware": true
    }
}
